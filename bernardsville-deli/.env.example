# Bville Pizza & Grill — local / production env
# Copy to .env and fill in WooCommerce REST credentials for card transactions.

# Public site URL (used in product image absolute paths when exporting)
# BVILLE_PUBLIC_URL=https://your-domain.example

# WooCommerce store (WordPress site with WooCommerce + Bville Menu plugin)
# Create keys under WooCommerce → Settings → Advanced → REST API
WC_STORE_URL=https://your-wordpress-store.example
WC_CONSUMER_KEY=ck_xxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxx
