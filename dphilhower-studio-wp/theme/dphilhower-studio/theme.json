{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        { "slug": "ink", "color": "#14110f", "name": "Charcoal" },
        { "slug": "paper", "color": "#e4dccb", "name": "Stone Paper" },
        { "slug": "wine", "color": "#3f141c", "name": "Wine" },
        { "slug": "brass", "color": "#c9a24a", "name": "Brass" },
        { "slug": "heat", "color": "#c45a2e", "name": "Ember" }
      ]
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1120px"
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "Syne, Avenir Next Condensed, Arial Narrow, sans-serif",
          "slug": "display",
          "name": "Syne"
        },
        {
          "fontFamily": "Newsreader, Iowan Old Style, Palatino Linotype, Georgia, serif",
          "slug": "body",
          "name": "Newsreader"
        },
        {
          "fontFamily": "IBM Plex Mono, ui-monospace, monospace",
          "slug": "mono",
          "name": "IBM Plex Mono"
        }
      ]
    }
  }
}
