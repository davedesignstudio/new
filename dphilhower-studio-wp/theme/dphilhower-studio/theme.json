{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        { "slug": "ink", "color": "#10140f", "name": "Ink" },
        { "slug": "paper", "color": "#f2f4ef", "name": "Paper" },
        { "slug": "verdigris", "color": "#2f6b66", "name": "Verdigris" },
        { "slug": "brass", "color": "#9a7b45", "name": "Brass" }
      ]
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1120px"
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "Syne, sans-serif",
          "slug": "display",
          "name": "Syne"
        },
        {
          "fontFamily": "Karla, sans-serif",
          "slug": "body",
          "name": "Karla"
        }
      ]
    }
  }
}
