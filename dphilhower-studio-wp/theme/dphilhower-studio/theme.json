{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        { "slug": "ink", "color": "#10140f", "name": "Ink" },
        { "slug": "paper", "color": "#f2f4ef", "name": "Paper" },
        { "slug": "verdigris", "color": "#1d4ed8", "name": "Cobalt" },
        { "slug": "brass", "color": "#d97706", "name": "Ember" }
      ]
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1120px"
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "Space Grotesk, sans-serif",
          "slug": "display",
          "name": "Space Grotesk"
        },
        {
          "fontFamily": "Inter, sans-serif",
          "slug": "body",
          "name": "Inter"
        }
      ]
    }
  }
}
